#!/usr/bin/env bash
# baton — menu of claude/codex SESSIONS to resume natively (no tmux).
#
# Pass the baton: start a session on one machine, pick it up on another over SSH.
# Lists sessions grouped by the directory they were started in, newest first.
# By default shows only ACTIVE sessions (a live claude/codex process exists);
# pass -a/--all to include closed ones. Selecting a session:
#   * if it is live, kills that process (after confirmation) so the work can't
#     diverge between two machines,
#   * cd's to the session's original directory (required: resume is cwd-scoped),
#   * runs `claude --resume <id>` / `codex resume <id>` NATIVELY in this terminal.
#
# Because nothing runs under tmux, mouse select / copy-paste / scroll are fully
# native on both Mac and Windows-SSH. Installs as `baton` (with `agents` as a
# backward-compatible alias).
#
# SHELL INTEGRATION (installed for you): the installer adds
#   eval "$(baton shell-init bash)"   # or zsh
# to your rc, which defines a `baton` shell FUNCTION. The function cd's your REAL
# shell to the session dir, then resumes — so when the session ends you are left
# IN the project directory (instead of back at ~). The function calls
# `baton --emit`, which runs the picker + live-handling and prints the chosen
# `tool<TAB>id<TAB>cwd` on stdout for the function to act on. Run as a bare binary
# with no function in play, baton falls back to cd + exec resume (resume works
# everywhere; only then does your shell stay put).
#
# Usage:  baton [-a|--all]
#         baton shell-init [bash|zsh]   # print the shell function (for eval)
#         baton --emit [-a|--all]       # internal: print selection, don't resume
# Run from Windows with:  ssh -t <mac-host> baton

set -uo pipefail

# Absolute path to self, for the fzf preview callback.
case $0 in
  /*) SELF=$0 ;;
  *)  SELF=$(command -v "$0" 2>/dev/null || echo "$PWD/$0") ;;
esac
# Name we were invoked as (baton, or the agents alias) — for user-facing messages.
PROG=$(basename "$SELF")

# --- embedded scanner -------------------------------------------------------
# _scan list <show_all 0|1>     -> TSV rows
# _scan preview <path> <tool>   -> human-readable tail of a session
_scan() {
  python3 - "$@" <<'PY'
import json, os, glob, subprocess, sys, time

HOME = os.path.expanduser('~')
mode = sys.argv[1] if len(sys.argv) > 1 else 'list'

# ---------- shared helpers ----------
def ago(sec):
    d = max(0, time.time() - sec)
    if d < 60:    return "%ds" % int(d)
    if d < 3600:  return "%dm" % int(d/60)
    if d < 86400: return "%dh" % int(d/3600)
    return "%dd" % int(d/86400)

def first_real_text(text):
    t = (text or "").strip()
    if not t: return None
    if t.startswith('<'): return None              # system/caveat/reminder blocks
    low = t[:40].lower()
    if low.startswith('caveat') or 'instructions' in low: return None
    return ' '.join(t.split())[:90]

# ---------- live process detection ----------
def proc_cwd(pid):
    """Working directory of a pid. Linux: read /proc/<pid>/cwd (instant).
    macOS / no-proc: fall back to lsof. Returns None if undeterminable."""
    # Linux fast path: /proc/<pid>/cwd is a symlink to the process cwd.
    link = '/proc/%s/cwd' % pid
    try:
        if os.path.islink(link):
            return os.readlink(link)
    except OSError:
        pass
    # Portable fallback (macOS uses this): lsof.
    try:
        out = subprocess.run(['lsof','-a','-p',str(pid),'-d','cwd','-Fn'],
                             capture_output=True, text=True, timeout=5).stdout
        for ln in out.splitlines():
            if ln.startswith('n'):
                return ln[1:]
    except Exception:
        pass
    return None

def running():
    """Return list of (tool, cwd, pid) for live interactive claude/codex leaves."""
    try:
        out = subprocess.run(['ps','-axww','-o','pid=,command='],
                             capture_output=True, text=True).stdout
    except Exception:
        return []
    res = []
    for line in out.splitlines():
        s = line.strip()
        if not s: continue
        pid, _, cmd = s.partition(' ')
        if not pid.isdigit(): continue
        tool = None
        # Real claude leaf: the toolbox injects --settings on the actual binary.
        if '/claude-code/' in cmd and '/claude ' in cmd and '--settings' in cmd:
            tool = 'claude'
        # Interactive codex leaf (exclude non-interactive `codex exec` runs).
        elif '/bin/codex' in cmd and ' exec' not in cmd:
            tool = 'codex'
        if not tool: continue
        cwd = proc_cwd(pid)
        if cwd:
            res.append((tool, cwd, int(pid)))
    return res

# ---------- session discovery ----------
def claude_files():
    out = []
    for f in glob.glob(os.path.join(HOME,'.claude','projects','*','*.jsonl')):
        try: mt = os.path.getmtime(f)
        except OSError: continue
        out.append(('claude', f, mt))
    return out

def codex_files():
    out = []
    for f in glob.glob(os.path.join(HOME,'.codex','sessions','*','*','*','rollout-*.jsonl')):
        try: mt = os.path.getmtime(f)
        except OSError: continue
        out.append(('codex', f, mt))
    return out

def claude_meta(f):
    """(session_id, launch_cwd, first_prompt). id == filename stem."""
    sid = os.path.basename(f)[:-6]
    cwd = prompt = None
    try:
        with open(f) as fh:
            for i, ln in enumerate(fh):
                if i > 400: break
                try: d = json.loads(ln)
                except Exception: continue
                if not isinstance(d, dict): continue
                if cwd is None and isinstance(d.get('cwd'), str):
                    cwd = d['cwd']
                if prompt is None and d.get('type') == 'user':
                    msg = d.get('message', {})
                    c = msg.get('content') if isinstance(msg, dict) else None
                    text = None
                    if isinstance(c, str): text = c
                    elif isinstance(c, list):
                        for p in c:
                            if isinstance(p, dict) and p.get('type') == 'text':
                                text = p.get('text'); break
                    prompt = first_real_text(text) or prompt
                if cwd and prompt: break
    except OSError:
        pass
    return sid, cwd, prompt

def codex_meta(f):
    """(session_id, launch_cwd, first_prompt) from the rollout file."""
    sid = cwd = prompt = None
    try:
        with open(f) as fh:
            for i, ln in enumerate(fh):
                if i > 300: break
                try: d = json.loads(ln)
                except Exception: continue
                if not isinstance(d, dict): continue
                if d.get('type') == 'session_meta':
                    p = d.get('payload', {}) or {}
                    sid = sid or p.get('id')
                    cwd = cwd or p.get('cwd')
                if prompt is None:
                    pl = d.get('payload', d)
                    if isinstance(pl, dict) and (pl.get('type') in ('user_message','message') or pl.get('role') == 'user'):
                        c = pl.get('content') or pl.get('text') or pl.get('message')
                        text = None
                        if isinstance(c, str): text = c
                        elif isinstance(c, list):
                            for q in c:
                                if isinstance(q, dict) and q.get('text'):
                                    text = q['text']; break
                        prompt = first_real_text(text) or prompt
                if sid and cwd and prompt: break
    except OSError:
        pass
    return sid, cwd, prompt

# ---------- preview ----------
# Show a clean Q&A transcript: the user's real questions and the assistant's
# actual answers — NOT thinking blocks, tool calls, tool results, or the
# "let me check X / now let me Y" narration between tool calls. We do this by
# keeping only text content, dropping tool_result-wrapper user turns, and
# collapsing consecutive assistant chatter into the single latest answer per
# turn (the substantive reply that precedes the next user question).
def preview(path, tool):
    try:
        lines = open(path).read().splitlines()
    except OSError:
        print("(cannot read session file)"); return

    def clean(s):
        s = ' '.join((s or '').split())
        if not s or s.startswith('<'): return None
        if s[:30].lower().startswith('caveat'): return None
        return s

    seq = []   # list of [role, text]; assistant runs collapse to the latest
    def add(role, text):
        text = clean(text)
        if not text: return
        if role == 'assistant' and seq and seq[-1][0] == 'assistant':
            seq[-1][1] = text          # collapse narration -> keep latest
        else:
            seq.append([role, text])

    for ln in lines:
        try: d = json.loads(ln)
        except Exception: continue
        if not isinstance(d, dict): continue
        if tool == 'claude':
            t = d.get('type')
            if t not in ('user','assistant'): continue
            msg = d.get('message', {})
            c = msg.get('content') if isinstance(msg, dict) else None
            if t == 'user':
                if isinstance(c, list) and any(isinstance(p, dict) and p.get('type') == 'tool_result' for p in c):
                    continue   # tool output fed back in, not a real question
                if isinstance(c, str): add('user', c)
                elif isinstance(c, list):
                    parts = [p.get('text') for p in c
                             if isinstance(p, dict) and p.get('type') == 'text' and p.get('text')]
                    if parts: add('user', ' '.join(parts))
            else:  # assistant: text blocks only (skips thinking + tool_use)
                if isinstance(c, list):
                    parts = [p.get('text') for p in c
                             if isinstance(p, dict) and p.get('type') == 'text' and p.get('text')]
                    if parts: add('assistant', ' '.join(parts))
        else:  # codex
            pl = d.get('payload', d)
            if not isinstance(pl, dict): continue
            ty = pl.get('type'); rl = pl.get('role')
            if not (rl in ('user','assistant') or ty in ('user_message','agent_message','message')):
                continue
            role = rl or ('assistant' if 'agent' in (ty or '') else 'user')
            c = pl.get('content') or pl.get('text')
            text = None
            if isinstance(c, str): text = c
            elif isinstance(c, list):
                parts = [q.get('text') for q in c if isinstance(q, dict) and q.get('text')]
                text = ' '.join(parts)
            add(role, text)

    for role, t in seq[-12:]:
        tag = 'You ▸' if role == 'user' else '  ◂ '
        print("%s %s" % (tag, t[:300]))
    if not seq:
        print("(no readable messages yet)")

# ---------- list ----------
def build(show_all):
    acts = running()
    active_pairs = {}                       # (tool,cwd) -> [pids]
    for tool, cwd, pid in acts:
        active_pairs.setdefault((tool, cwd), []).append(pid)

    files = claude_files() + codex_files()
    files.sort(key=lambda x: x[2], reverse=True)   # newest mtime first

    rows = []
    used = {}                               # (tool,cwd) -> count marked active
    parsed = 0
    PARSE_CAP = 90
    RECENT_INACTIVE = 10                     # default view: active + N most-recent closed
    inactive_kept = 0
    for tool, path, mt in files:            # files are newest-mtime first
        if parsed >= PARSE_CAP: break
        parsed += 1
        if tool == 'claude': sid, cwd, prompt = claude_meta(path)
        else:                sid, cwd, prompt = codex_meta(path)
        if not sid or not cwd: continue
        key = (tool, cwd)
        is_active = 0
        if key in active_pairs:
            u = used.get(key, 0)
            if u < len(active_pairs[key]):
                used[key] = u + 1
                is_active = 1
        if not is_active and not show_all:
            # Default view: keep only the N most-recent closed sessions. Because
            # files are sorted newest-first, the first N inactive we see are them.
            if inactive_kept >= RECENT_INACTIVE:
                continue
            inactive_kept += 1
        pids = ','.join(str(p) for p in active_pairs.get(key, [])) if is_active else ''
        rows.append({'path':path,'tool':tool,'id':sid,'cwd':cwd,
                     'active':is_active,'pids':pids,'mtime':mt,'prompt':prompt or '(no prompt yet)'})

    # Group by directory: most-recently-active group first, sessions by date.
    gmax = {}
    for r in rows:
        gmax[r['cwd']] = max(gmax.get(r['cwd'], 0), r['mtime'])
    rows.sort(key=lambda r: (-gmax[r['cwd']], r['cwd'], -r['mtime']))

    # --all has a generous safety cap; default view is already bounded by the
    # loop (all active + RECENT_INACTIVE) so it isn't truncated here.
    if show_all:
        rows = rows[:40]

    # ANSI colors (fzf --ansi renders these).
    C_DIR = '\033[1;36m'   # bold cyan folder header
    C_DOT = '\033[1;32m'   # green live dot
    C_TOOL= '\033[35m'     # magenta tool name
    C_AGE = '\033[90m'     # dim age
    C_TXT = '\033[37m'     # prompt text
    C_OFF = '\033[0m'

    # One line per session. A folder header row is emitted once per group; its
    # tab-fields carry no session id, so selecting it is a no-op (guarded later).
    # Session rows are indented and always self-describing (tool · age · prompt).
    prev = None
    home = os.path.expanduser('~')
    for r in rows:
        if r['cwd'] != prev:
            prev = r['cwd']
            disp_dir = r['cwd'].replace(home, '~')
            header = "%s%s%s" % (C_DIR, disp_dir, C_OFF)
            # header row: empty id/path -> not selectable
            print('\t'.join(['', '', '', r['cwd'], '0', '', header]))
        dot = ("%s●%s" % (C_DOT, C_OFF)) if r['active'] else ' '
        a   = "%s%4s%s" % (C_AGE, ago(r['mtime']), C_OFF)
        tool= "%s%-6s%s" % (C_TOOL, r['tool'], C_OFF)
        txt = "%s%s%s" % (C_TXT, r['prompt'][:80], C_OFF)
        disp = "  %s %s %s  %s" % (dot, tool, a, txt)
        print('\t'.join([r['path'], r['tool'], r['id'], r['cwd'], str(r['active']), r['pids'], disp]))

if mode == 'preview':
    preview(sys.argv[2], sys.argv[3])
else:
    show_all = (len(sys.argv) > 2 and sys.argv[2] == '1')
    build(show_all)
PY
}

# --- preview reentry --------------------------------------------------------
if [ "${1:-}" = "--preview" ]; then
  shift
  # Folder header rows pass an empty path; nothing to preview.
  if [ -z "${1:-}" ]; then
    echo "  (folder — pick a session below it)"
    exit 0
  fi
  _scan preview "$@"
  exit 0
fi

# --- shell integration ------------------------------------------------------
# `baton shell-init [bash|zsh]` prints a shell FUNCTION to be eval'd from your rc
# (the installer wires this for you). The function runs IN your shell, so it can
# cd your real shell into the session dir and THEN resume — leaving you in the
# project directory when the session ends. It calls the binary by ABSOLUTE PATH
# ($SELF), which is both PATH-independent and recursion-proof (a bare `baton`
# would re-enter the function). Needs no python3/fzf/tty, so it runs before those.
if [ "${1:-}" = "shell-init" ]; then
  # Bake in an ABSOLUTE path so the function works from any cwd. $SELF is already
  # absolute when baton is invoked via PATH (installed case); absolutize it here
  # so a relative dev invocation (./bin/baton shell-init) is also correct.
  bin="$SELF"
  case "$bin" in
    /*) : ;;
    *)  bin="$(cd "$(dirname "$bin")" 2>/dev/null && pwd)/$(basename "$bin")" ;;
  esac
  cat <<EOF
baton() {
  local sel tool id cwd st
  sel="\$('$bin' --emit "\$@")" || return \$?
  [ -n "\$sel" ] || return 0
  IFS=\$'\t' read -r tool id cwd <<< "\$sel"
  case "\$tool" in claude|codex) ;; *) printf 'baton: unexpected selection\n' >&2; return 2 ;; esac
  [ -n "\$id" ] && [ -n "\$cwd" ] || { printf 'baton: incomplete selection\n' >&2; return 2; }
  cd -- "\$cwd" || return
  case "\$tool" in
    claude) command claude --resume "\$id"; st=\$? ;;
    codex)  command codex resume "\$id"; st=\$? ;;
  esac
  return "\$st"
}
agents() { baton "\$@"; }
EOF
  exit 0
fi

command -v python3 >/dev/null 2>&1 || { echo "$PROG: python3 required" >&2; exit 1; }
command -v fzf     >/dev/null 2>&1 || { echo "$PROG: fzf required" >&2; exit 1; }

# Args are order-independent: --emit (internal: print selection instead of
# resuming, for the shell function) and -a/--all (include closed sessions).
emit=0
show_all=0
for arg in "$@"; do
  case "$arg" in
    --emit)   emit=1 ;;
    -a|--all) show_all=1 ;;
  esac
done

# The picker draws on the controlling terminal (/dev/tty), so REQUIRE one. We test
# /dev/tty rather than stdout because in --emit mode stdout is a capture pipe
# (sel="$(baton --emit)"), so a stdout test would wrongly reject the normal case.
if ! { : >/dev/tty; } 2>/dev/null; then
  echo "$PROG needs a terminal. From another machine run:  ssh -t <host> $PROG" >&2
  exit 1
fi

rows=$(_scan list "$show_all")

if [ -z "$rows" ]; then
  # On stderr so --emit's stdout stays empty (the function treats that as a no-op).
  echo "No claude/codex sessions found." >&2
  exit 0
fi

hdr="enter resume · esc quit"
[ "$show_all" = 0 ] && hdr="● live + 10 recent · $hdr · ($PROG --all for everything)"

sel=$(printf '%s\n' "$rows" | fzf \
  --ansi \
  --delimiter='\t' \
  --with-nth=7 \
  --no-sort \
  --layout=reverse \
  --prompt='resume> ' \
  --header="$hdr" \
  --preview="$SELF --preview {1} {2}" \
  --preview-window='right,55%,wrap' \
  --bind='esc:abort')
[ -z "$sel" ] && exit 0

# Parse the chosen TSV line. Fields 1 (path) and 7 (display) are consumed only
# by fzf (preview callback / display column), so they're discarded here as `_`.
IFS=$'\t' read -r _ tool id cwd active pids _ <<<"$sel"
# Folder header rows have no id — selecting one exits cleanly with no stdout, so
# the shell function treats it as a no-op.
[ -z "$id" ] && exit 0

# If live, confirm and end the existing process so work can't diverge. All of
# this is user interaction → route to /dev/tty so --emit's stdout stays clean
# (only the final metadata line may land on stdout).
if [ "$active" = "1" ] && [ -n "$pids" ]; then
  {
    echo "This session is LIVE (pid(s): $pids) in: $cwd"
    printf "End that process and resume here? [y/N] "
  } >/dev/tty
  read -r ans </dev/tty
  case "$ans" in
    y|Y) for p in ${pids//,/ }; do kill "$p" 2>/dev/null; done; sleep 1 ;;
    *)   echo "cancelled" >/dev/tty; exit 0 ;;
  esac
fi

# --emit: hand the selection back to the shell function, which does the cd +
# resume IN your shell (so you end up in $cwd). Nothing else on stdout.
if [ "$emit" = "1" ]; then
  printf '%s\t%s\t%s\n' "$tool" "$id" "$cwd"
  exit 0
fi

# Fallback (bare binary, no shell function in play — e.g. fresh `ssh -t host
# baton`): cd then exec resume. Resume works, but the parent shell can't be
# moved from a child, so it stays put. Install the shell integration
# (`eval "$(baton shell-init bash)"`) to be left in $cwd after the session.
# Plain `exec claude`/`exec codex` (NOT `exec command claude`): in exec position
# `command` is a program name, not the builtin — relying on /usr/bin/command
# existing is a portability trap (absent on many Linux boxes).
cd "$cwd" 2>/dev/null || { echo "$PROG: cannot cd to $cwd" >&2; exit 1; }
echo "Resuming $tool in $cwd …" >&2
if [ "$tool" = "claude" ]; then
  exec claude --resume "$id"
else
  exec codex resume "$id"
fi
